
{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\server\\index.js"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Python WebSocket Server",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}\\client"
        }
    ],
    "compounds": [
        {
            "name": "Client and Server",
            "configurations": [
                "Server",
                "Python WebSocket Server"
            ],
            "stopAll": true
        }
    ]
}
